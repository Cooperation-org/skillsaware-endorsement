# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-please-change
JWT_EXPIRY_DAYS=7

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=skillsaware-artifacts
S3_PREFIX=endorsements

# Tenant Configuration
SKILLSAWARE_API_KEY=your-api-key
SKILLSAWARE_WEBHOOK_URL=http://localhost:3001/api/webhook
SKILLSAWARE_WEBHOOK_SECRET=your-webhook-secret

# Optional: Branding
BRAND_LOGO_URL=https://example.com/logo.png
BRAND_PRIMARY_COLOR=#0B5FFF

# Optional: External Services
SENDGRID_API_KEY=optional-for-email-delivery

API_BASE_URL=https://mainendpoint.com (without trailing slash or api/v1)